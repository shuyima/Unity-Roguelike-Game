using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class Player : MonoBehaviour
{
    private Rigidbody2D rigidbody2D;
    private Vector2 targetPos=new Vector2(1f,1f);
    public float smoothing = 8;
    private BoxCollider2D collider2D;

    public float restTime = 0.5f;
    private float restTimer=0f;
    // Start is called before the first frame update
    void Start()
    {
        rigidbody2D=GetComponent<Rigidbody2D>();
        collider2D=GetComponent<BoxCollider2D>();
    }

    // Update is called once per frame
    void Update()
    {
        
    }
    void FixedUpdate()
    {
        Vector2 dif=new Vector2(transform.position.x-targetPos.x,transform.position.y-targetPos.y);
        if(dif.magnitude>0.01f)
            rigidbody2D.MovePosition(Vector2.Lerp(transform.position, targetPos, Time.deltaTime*smoothing));
        else
        {
            float h = Input.GetAxis("Horizontal");
            float v = Input.GetAxis("Vertical");
            if (h != 0 || v != 0)
            {
                if (h != 0)
                    h = h / Mathf.Abs(h);
                if(v!=0)
                    v = v / Mathf.Abs(v);
                restTimer+=Time.deltaTime;
                if (restTimer < restTime)
                    return;

                collider2D.enabled=false;
                RaycastHit2D hit=Physics2D.Linecast(targetPos,targetPos+new Vector2(h,v));
                collider2D.enabled=true;
                if (hit.transform == null)
                    targetPos += new Vector2(h, v);
                else
                {
                    switch (hit.collider.tag)
                    {
                        case "OutWall":
                            break;
                        case "Wall":
                            hit.collider.SendMessage("TakeDamage");
                            break;
                    }
                }
            }
            restTimer=0f;
               
        }

    }
}
